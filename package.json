{
  "name": "home-assistant-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.js",
    "check": "node --check server/index.js && node --check server/ha.js && node --check server/waste.js && node --check public/app.js",
    "pretest": "npm run build",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs"
  }
}
